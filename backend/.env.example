# Jeton partagé avec l'app iPhone (générer avec : openssl rand -hex 32)
MARCEL_TOKEN=
# Hermes, joignable uniquement par le réseau Docker interne
HERMES_URL=http://hermes:8642
HERMES_API_KEY=
HERMES_MODEL=hermes-agent
# Modèle par défaut, tel que Hermes le connaît.
# Les modèles proposés dans l'app sont lus chez Hermes (GET /v1/models).
# Pour imposer la liste : id=Libellé séparés par des virgules (pas de virgule dans un libellé),
# le premier est celui par défaut. Ex. : deepseek-r1-distill-llama-70b=DeepSeek R1,deepseek-v3=DeepSeek V3
MARCEL_MODELS=
# 1 = réponses factices, sans Hermes
MARCEL_MOCK=0
# Mémoire : taille du noyau (caractères envoyés à chaque mission) et heure du rangement nocturne
MARCEL_MEMORY_CORE_CHARS=1500
MARCEL_MEMORY_TIDY_HOUR=3
# Modèle qui extrait et range les souvenirs (compatible OpenAI). Vide = Hermes.
# URL de base sans /v1 (ex. accès direct Scaleway : https://api.scaleway.ai).
MARCEL_MEMORY_LLM_URL=
MARCEL_MEMORY_LLM_KEY=
MARCEL_MEMORY_LLM_MODEL=
# Marcel proactif : intervalle du planificateur (secondes), heures où les vérifications partent
# (heure du serveur) et plafond de vérifications par jour (modifiable ensuite dans l'app).
MARCEL_PROACTIVE_TICK_SECONDS=900
MARCEL_PROACTIVE_HOURS=8-21
MARCEL_PROACTIVE_MAX_CHECKS=6
# Hermes des vérifications : un second profil sans outils qui agissent (deploy/hermes-checks.config.yaml).
# Vide = le Hermes principal (la consigne « ne rien faire » n'est alors qu'une consigne).
MARCEL_CHECK_HERMES_URL=
MARCEL_CHECK_HERMES_KEY=
# Modèle de ce profil, s'il diffère du modèle par défaut de Marcel.
MARCEL_CHECK_HERMES_MODEL=
# llm-guard (deploy/install-guard.sh) : Marcel y lit la consommation de tokens du jour,
# avec la clé MARCEL_MEMORY_LLM_KEY. Vide = pas de garde-fou.
MARCEL_GUARD_URL=
