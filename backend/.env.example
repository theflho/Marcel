# Jeton partagé avec l'app iPhone (générer avec : openssl rand -hex 32)
MARCEL_TOKEN=
# Clé du Hermes principal pour les outils de lecture de Marcel (/mcp, voir deploy/hermes-mcp.config.yaml).
# openssl rand -hex 32. Vide = pas d'outils MCP. Ne pas réutiliser MARCEL_TOKEN.
MARCEL_MCP_TOKEN=
# Hermes, joignable uniquement par le réseau Docker interne
HERMES_URL=http://hermes:8642
HERMES_API_KEY=
HERMES_MODEL=hermes-agent
# Modèle par défaut, tel que Hermes le connaît.
# Les modèles proposés dans l'app sont lus chez Hermes (GET /v1/models).
# Pour imposer la liste : id=Libellé séparés par des virgules (pas de virgule dans un libellé),
# le premier est celui par défaut. Ex. : deepseek-r1-distill-llama-70b=DeepSeek R1,deepseek-v3=DeepSeek V3
MARCEL_MODELS=
# 1 = réponses factices, sans Hermes
MARCEL_MOCK=0
# Mémoire : taille du noyau (caractères envoyés à chaque mission) et heure du rangement nocturne
MARCEL_MEMORY_CORE_CHARS=1500
MARCEL_MEMORY_TIDY_HOUR=3
# Modèle qui extrait et range les souvenirs (compatible OpenAI). Vide = Hermes.
# URL de base sans /v1 (ex. accès direct Scaleway : https://api.scaleway.ai).
MARCEL_MEMORY_LLM_URL=
MARCEL_MEMORY_LLM_KEY=
MARCEL_MEMORY_LLM_MODEL=
# Recherche par le sens (embeddings, /v1/embeddings compatible OpenAI) : mémoire, réponses passées
# et planning. Par défaut la même adresse et la même clé que MARCEL_MEMORY_LLM_* (pas Hermes, qui
# n'a pas d'embeddings). Modèle « off » = désactivé ; sans adresse, rien n'est indexé (sauf en
# MARCEL_MOCK, avec un substitut local). Score minimal (0 à 1) : 0.5 par défaut, à ajuster au modèle.
MARCEL_EMBED_MODEL=bge-multilingual-gemma2
MARCEL_EMBED_URL=
MARCEL_EMBED_KEY=
MARCEL_EMBED_MIN_SCORE=
# Marcel proactif : intervalle du planificateur (secondes), heures où les vérifications partent
# (heure du serveur) et plafond de vérifications par jour (modifiable ensuite dans l'app).
MARCEL_PROACTIVE_TICK_SECONDS=900
MARCEL_PROACTIVE_HOURS=8-21
MARCEL_PROACTIVE_MAX_CHECKS=6
# Hermes des vérifications : un second profil sans outils qui agissent (deploy/hermes-checks.config.yaml).
# Vide = le Hermes principal (la consigne « ne rien faire » n'est alors qu'une consigne).
MARCEL_CHECK_HERMES_URL=
MARCEL_CHECK_HERMES_KEY=
# Modèle de ce profil, s'il diffère du modèle par défaut de Marcel.
MARCEL_CHECK_HERMES_MODEL=
# llm-guard (deploy/install-guard.sh) : Marcel y lit la consommation de tokens du jour,
# avec la clé MARCEL_MEMORY_LLM_KEY. Vide = pas de garde-fou.
MARCEL_GUARD_URL=
# Gmail en lecture seule (python -m app.gmail_auth) : client OAuth « Application de bureau »
# de ton projet Google Cloud. Vide = pas d'e-mail.
MARCEL_GOOGLE_CLIENT_ID=
MARCEL_GOOGLE_CLIENT_SECRET=
# Modèle renfort (facultatif, autre fournisseur via GUARD_ROUTES de llm-guard) : l'app propose
# alors « Auto » (le modèle habituel, et celui-ci pour les messages longs ou délicats).
# Hermes doit accepter un modèle par requête : direct_model_requests: true (voir README).
MARCEL_STRONG_MODEL=
MARCEL_STRONG_LABEL=
# Routines (tâches à heure fixe) : nombre maximal de passages par jour.
MARCEL_ROUTINES_MAX_PER_DAY=10
# Code de Marcel sur GitHub : dépôt de l'app (propriétaire/nom) et clé fine-grained limitée à ce dépôt
# (Contents, Issues et Pull requests : lecture et écriture ; Actions : lecture). Marcel
# modifie alors son code lui-même (outils marcel_code_*), ouvre la pull request et la fusionne au
# vert de la CI ; deploy/auto-update.sh déploie. Vide = ni outils de code, ni demandes aux agents.
MARCEL_GITHUB_REPO=
MARCEL_GITHUB_TOKEN=
# Agent de code pour les gros chantiers (modifiable dans l'app) : claude (Claude Code) ou codex (OpenAI).
MARCEL_CODE_AGENT=claude
# Conteneur du Hermes principal, redémarré par deploy/auto-update.sh quand sa config change.
MARCEL_HERMES_CONTAINER=hermes
# Navigateur de Hermes : 1 = coupé sans accord explicite (« Vas-y ») de l'utilisateur. 0 = libre.
# Le coffre (browser_vault : identifiants et carte de Marcel) suit les règles « Comptes » et
# « Réservations et achats » de l'app ; jamais dans une routine. N'y mettre que l'identité de Marcel
# et une carte virtuelle plafonnée, jamais tes propres mots de passe ni ta vraie carte.
MARCEL_BROWSER_GUARD=0
# Boîte mail de Marcel (AgentMail, https://agentmail.to), pour les comptes qu'il crée : il la lit
# seulement (codes et liens de confirmation). Vide = pas de boîte. Sans INBOX, la première du compte.
MARCEL_AGENTMAIL_KEY=
MARCEL_AGENTMAIL_INBOX=
